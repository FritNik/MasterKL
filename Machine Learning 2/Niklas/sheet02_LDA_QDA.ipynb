import numpy as np

# Define the common parameters
mean = [0.7, 0]
covariance_matrix = [[1, 1], 
                     [1, 2]]

# --- (a) Simulate 10 values ---
n_samples_10 = 10
# The 'size' parameter dictates the number of samples (rows) to draw.
samples_10 = np.random.multivariate_normal(mean, covariance_matrix, size=n_samples_10)

print(f"--- {n_samples_10} Samples from the Distribution ---")
print(samples_10)
print(f"Shape: {samples_10.shape}\n")

# --- (a) Simulate 100 values ---
n_samples_100 = 100
samples_100 = np.random.multivariate_normal(mean, covariance_matrix, size=n_samples_100)

print(f"--- {n_samples_100} Samples from the Distribution ---")
print(samples_100)
print(f"Shape: {samples_100.shape}")